# =============================================
# ShepidiSoft Academy — Production Environment
# =============================================
# Bu dosyayı .env.production olarak kopyalayıp
# gerçek değerleri girin. Asla git'e commit etmeyin!

# =============================================
# Database
# =============================================
CONNECTIONSTRINGS__SQLSERVER=Server=YOUR_DB_HOST;Database=YOUR_DB_NAME;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;

# =============================================
# JWT
# =============================================
JWT__ISSUER=Shepidi Soft
JWT__AUDIENCE=shepidisoft.net
JWT__SECRETKEY=REPLACE_WITH_STRONG_256BIT_SECRET_KEY_HERE
JWT__EXPIRYMINUTES=60

# =============================================
# Email
# =============================================
EMAILSETTINGS__HOST=smtp.gmail.com
EMAILSETTINGS__PORT=587
EMAILSETTINGS__SENDERNAME=Shepidi Soft
EMAILSETTINGS__SENDEREMAIL=your-email@gmail.com
EMAILSETTINGS__PASSWORD=your-app-password

# =============================================
# App
# =============================================
APPSETTINGS__BASEURL=https://your-production-domain.com
