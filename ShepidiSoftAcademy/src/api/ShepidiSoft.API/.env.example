# =============================================
# Database
# =============================================
CONNECTIONSTRINGS__NPGSQL=Host=YOUR_HOST;Port=5432;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# =============================================
# JWT
# =============================================
JWT__ISSUER=Shepidi Soft
JWT__AUDIENCE=shepidisoft.net
JWT__SECRETKEY=your-very-long-secret-key-here
JWT__EXPIRYMINUTES=5

# =============================================
# Email
# =============================================
EMAILSETTINGS__HOST=smtp.gmail.com
EMAILSETTINGS__PORT=587
EMAILSETTINGS__SENDERNAME=Shepidi Soft
EMAILSETTINGS__SENDEREMAIL=your-email@gmail.com
EMAILSETTINGS__PASSWORD=your-app-password

# =============================================
# Gemini AI
# =============================================
GEMINISETTINGS__APIKEY=your-gemini-api-key
GEMINISETTINGS__APIURL=https://generativelanguage.googleapis.com

# =============================================
# App
# =============================================
APPSETTINGS__BASEURL=https://localhost:7149
